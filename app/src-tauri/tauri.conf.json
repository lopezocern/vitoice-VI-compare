{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VitoiceCompare",
  "version": "0.1.0",
  "identifier": "com.vitoice.vitoicecompare",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VitoiceCompare",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
